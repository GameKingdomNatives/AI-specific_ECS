{
  "name": "agent-specific_ecs",
  "version": "0.1.0",
  "description": "Agent-native, tool-agnostic 2D ECS runtime kernel. Prototype; not production-ready. 中文：agent 原生、工具无关的 2D ECS 运行时内核（原型，不建议生产使用）。",
  "keywords": ["ecs", "agent-native", "tool-agnostic", "deterministic", "2d", "typescript"],
  "private": false,
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./core": {
      "types": "./dist/src/core/index.d.ts",
      "default": "./dist/src/core/index.js"
    },
    "./ports": {
      "types": "./dist/src/ports/index.d.ts",
      "default": "./dist/src/ports/index.js"
    },
    "./impl": {
      "types": "./dist/src/impl/pixi-renderer.d.ts",
      "default": "./dist/src/impl/pixi-renderer.js"
    },
    "./bridge": {
      "types": "./dist/src/bridge/index.d.ts",
      "default": "./dist/src/bridge/index.js"
    },
    "./logger": {
      "types": "./dist/src/impl/logger.d.ts",
      "default": "./dist/src/impl/logger.js"
    },
    "./audio": {
      "types": "./dist/src/impl/audio.d.ts",
      "default": "./dist/src/impl/audio.js"
    },
    "./diagnostics": {
      "types": "./dist/src/impl/diagnostics.d.ts",
      "default": "./dist/src/impl/diagnostics.js"
    },
    "./physics": {
      "types": "./dist/src/impl/physics.d.ts",
      "default": "./dist/src/impl/physics.js"
    },
    "./data": {
      "types": "./dist/src/data/index.d.ts",
      "default": "./dist/src/data/index.js"
    },
    "./storage": {
      "types": "./dist/src/impl/storage.d.ts",
      "default": "./dist/src/impl/storage.js"
    },
    "./determinism": {
      "types": "./dist/src/determinism/index.d.ts",
      "default": "./dist/src/determinism/index.js"
    },
    "./scene": {
      "types": "./dist/src/scene/index.d.ts",
      "default": "./dist/src/scene/index.js"
    }
  },
  "dependencies": {
    "@pixi/sound": "^6.0.1",
    "pixi.js": "^8.22.0",
    "zod": "^4.6.7"
  },
  "files": [
    "dist/src",
    "docs",
    "README.md"
  ]
}
