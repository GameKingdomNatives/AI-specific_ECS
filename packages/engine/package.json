      "types": "./dist/src/data/index.d.ts",
      "default": "./dist/src/data/index.js"
    },
    "./storage": {
      "types": "./dist/src/impl/storage.d.ts",
      "default": "./dist/src/impl/storage.js"
    },
    "./determinism": {
      "types": "./dist/src/determinism/index.d.ts",
      "default": "./dist/src/determinism/index.js"
    },
    "./scene": {
      "types": "./dist/src/scene/index.d.ts",
      "default": "./dist/src/scene/index.js"
    }
  },
  "dependencies": {
    "@pixi/sound": "^6.0.1",
    "pixi.js": "^8.22.0",
    "zod": "^4.6.7"
  },
  "files": [
    "dist/src",
    "README.md"
