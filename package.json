{
  "name": "into-the-battlefield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "node tools/setup.mjs",
    "dev": "node node_modules/vite/bin/vite.js apps/game --port 5173",
    "preview": "node node_modules/vite/bin/vite.js preview apps/game --port 4173",
    "gate": "node tools/gate.mjs",
    "gate:fast": "node tools/gate.mjs --fast",
    "gate:status": "node tools/status.mjs",
    "bench": "node tools/bench.mjs",
    "gen:assets": "node tools/gen-assets.mjs",
    "storybook": "cd apps/game && storybook dev -p 6006",
    "storybook:build": "cd apps/game && storybook build -o ../../artifacts/storybook-static",
    "storybook:serve": "node tools/serve-static.mjs artifacts/storybook-static 7007",
    "starter": "cd starters/ui-storybook-kit && storybook dev -p 6007",
    "starter:build": "cd starters/ui-storybook-kit && storybook build -o ../../artifacts/starter-storybook",
    "panel": "node tools/panel/collect.mjs && node tools/panel/open.mjs",
    "review": "node tools/review.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -b",
    "test": "node tools/gate.mjs --fast",
    "replay": "node tools/replay.mjs",
    "drill": "node tools/drill.mjs"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.39.5",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
